/* DOWNLOAD SHEET */

document.getElementById(
"downloadSheet"
).addEventListener(
"click",
function(){

const sheet=
document.getElementById(
"sheetCanvas"
);


const a=
document.createElement("a");


a.href=
sheet.toDataURL(
"image/jpeg",
0.95
);


a.download=
"AsimTech_ID_Photo_4x6.jpg";


document.body.appendChild(a);

a.click();

document.body.removeChild(a);


success(
"✅ Download Successful!<br>4×6 sheet saved."
);

});


/* SUCCESS */

function success(message){

const box=
document.getElementById(
"success"
);

box.innerHTML=message;

box.classList.add("show");


setTimeout(
function(){

box.classList.remove("show");

},
3000
);

}


