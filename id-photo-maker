<script>

let image=null;
let resultBlob=null;
let resultURL=null;

let currentFilter="normal";

let dragX=0;
let dragY=0;

let dragging=false;
let lastX=0;
let lastY=0;


const file=document.getElementById("file");

const info=document.getElementById("info");

const editor=document.getElementById("editor");

const canvas=document.getElementById("canvas");

const ctx=canvas.getContext("2d");

const width=document.getElementById("width");

const height=document.getElementById("height");

const brightness=document.getElementById("brightness");

const contrast=document.getElementById("contrast");

const saturation=document.getElementById("saturation");

const zoom=document.getElementById("zoom");


/* SIZE PRESETS */

const sizes={

passport:[413,531],

stamp:[295,413],

"2x2":[600,600]

};


function preset(type,button){

document
.querySelectorAll(".preset")
.forEach(
b=>b.classList.remove("active")
);

button.classList.add("active");

if(sizes[type]){

width.value=sizes[type][0];

height.value=sizes[type][1];

}

if(image){

draw();

}

}


/* LOAD PHOTO */

file.addEventListener(
"change",
function(){

const f=this.files[0];

if(!f)return;

if(!f.type.startsWith("image/")){

alert(
"Please select an image."
);

return;

}

const reader=new FileReader();

reader.onload=function(e){

const img=new Image();

img.onload=function(){

image=img;

info.innerText=
"Original: "+
img.width+
" × "+
img.height+
" px";

editor.style.display="block";

draw();

};

img.src=e.target.result;

};

reader.readAsDataURL(f);

});


/* FILTER */

function filterPhoto(type,button){

currentFilter=type;

document
.querySelectorAll(".filter")
.forEach(
b=>b.classList.remove("active")
);

button.classList.add("active");

draw();

}


/* FILTER STRING */

function getFilter(){

let f="";

f+=
"brightness("+
brightness.value+
"%) ";

f+=
"contrast("+
contrast.value+
"%) ";

f+=
"saturate("+
saturation.value+
"%) ";

if(currentFilter==="bw")
f+="grayscale(100%) ";

if(currentFilter==="sepia")
f+="sepia(100%) ";

if(currentFilter==="vivid")
f+="saturate(180%) contrast(110%) ";

if(currentFilter==="cool")
f+="hue-rotate(15deg) ";

if(currentFilter==="warm")
f+="sepia(20%) saturate(125%) ";

if(currentFilter==="soft")
f+="brightness(108%) contrast(90%) ";

if(currentFilter==="dramatic")
f+="contrast(140%) saturate(120%) ";

return f;

}


/* DRAW PREVIEW */

function draw(){

if(!image)return;

const maxWidth=850;

const scale=
Math.min(
1,
maxWidth/image.width
);

canvas.width=
Math.round(image.width*scale);

canvas.height=
Math.round(image.height*scale);

ctx.clearRect(
0,
0,
canvas.width,
canvas.height
);


const z=
parseInt(zoom.value)/100;

const w=
canvas.width*z;

const h=
canvas.height*z;


ctx.filter=getFilter();

ctx.drawImage(

image,

(canvas.width-w)/2+
dragX,

(canvas.height-h)/2+
dragY,

w,

h

);

ctx.filter="none";

}


/* SLIDERS */

brightness.addEventListener(
"input",
function(){

document.getElementById(
"brightnessValue"
).innerText=
this.value+"%";

draw();

});


contrast.addEventListener(
"input",
function(){

document.getElementById(
"contrastValue"
).innerText=
this.value+"%";

draw();

});


saturation.addEventListener(
"input",
function(){

document.getElementById(
"saturationValue"
).innerText=
this.value+"%";

draw();

});


zoom.addEventListener(
"input",
function(){

document.getElementById(
"zoomValue"
).innerText=
this.value+"%";

draw();

});


document.getElementById(
"quality"
).addEventListener(
"input",
function(){

document.getElementById(
"qualityValue"
).innerText=
this.value+"%";

});


/* DRAG PHOTO */

canvas.addEventListener(
"pointerdown",
function(e){

dragging=true;

lastX=e.clientX;

lastY=e.clientY;

canvas.setPointerCapture(
e.pointerId
);

});


canvas.addEventListener(
"pointermove",
function(e){

if(!dragging)return;

dragX+=
e.clientX-lastX;

dragY+=
e.clientY-lastY;

lastX=e.clientX;

lastY=e.clientY;

draw();

});


canvas.addEventListener(
"pointerup",
function(){

dragging=false;

});


/* QUICK KB */

function quickSize(){

document.getElementById(
"targetKB"
).value=
document.getElementById(
"quickKB"
).value;

}


/* CREATE */

function createPhoto(){

if(!image){

alert(
"Please select a photo first."
);

return;

}


const W=parseInt(width.value);

const H=parseInt(height.value);


if(
!W||
!H||
W<20||
H<20
){

alert(
"Please enter valid dimensions."
);

return;

}


document.getElementById(
"status"
).innerText=
"⏳ Creating ID photo...";


const outCanvas=
document.createElement("canvas");

outCanvas.width=W;

outCanvas.height=H;

const out=
outCanvas.getContext("2d");


/* WHITE BACKGROUND */

if(
document.getElementById(
"whiteBg"
).checked
){

out.fillStyle="white";

out.fillRect(
0,
0,
W,
H
);

}


/* CROP */

let sx=0;
let sy=0;
let sw=image.width;
let sh=image.height;


if(
document.getElementById(
"autoCrop"
).checked
){

const targetRatio=W/H;

const sourceRatio=
image.width/image.height;


if(sourceRatio>targetRatio){

sw=
image.height*
targetRatio;

sx=
(image.width-sw)/2;

}else{

sh=
image.width/
targetRatio;

sy=
(image.height-sh)/2;

}

}


/* ZOOM */

const z=
parseInt(zoom.value)/100;

sw/=z;

sh/=z;


const centerX=
sx+
sw*z/2-
(dragX/canvas.width)*
image.width;

const centerY=
sy+
sh*z/2-
(dragY/canvas.height)*
image.height;


sx=
centerX-sw/2;

sy=
centerY-sh/2;


out.filter=getFilter();


out.drawImage(

image,

sx,
sy,
sw,
sh,

0,
0,
W,
H

);


out.filter="none";


const mime=
document.getElementById(
"format"
).value;


const quality=
parseInt(
document.getElementById(
"quality"
).value
)/100;


const target=
parseFloat(
document.getElementById(
"targetKB"
).value
);


if(
target &&
mime!=="image/png"
){

compressTarget(
outCanvas,
mime,
target,
W,
H,
quality
);

}else{

outCanvas.toBlob(

function(blob){

finish(
blob,
W,
H
);

},

mime,
quality

);

}

}


/* COMPRESS TO TARGET KB */

function compressTarget(
c,
mime,
target,
W,
H,
q
){

function attempt(){

c.toBlob(

function(blob){

if(!blob){

document.getElementById(
"status"
).innerText=
"❌ Could not create photo.";

return;

}


const kb=
blob.size/1024;


if(
kb<=target||
q<=0.1
){

finish(
blob,
W,
H
);

return;

}


q-=0.05;

attempt();

},

mime,
q

);

}

attempt();

}


/* FINISH */

function finish(blob,W,H){

resultBlob=blob;


if(resultURL)
URL.revokeObjectURL(
resultURL
);


resultURL=
URL.createObjectURL(
blob
);


document.getElementById(
"resultImg"
).src=resultURL;


document.getElementById(
"result"
).style.display=
"block";


document.getElementById(
"downloadBtn"
).style.display=
"block";


document.getElementById(
"sheetBtn"
).style.display=
"block";


const kb=
(blob.size/1024).toFixed(1);


document.getElementById(
"resultInfo"
).innerText=
W+
" × "+
H+
" px • "+
kb+
" KB";


document.getElementById(
"status"
).innerText=
"✅ ID Photo created successfully!";

}


/* DOWNLOAD */

document.getElementById(
"downloadBtn"
).addEventListener(
"click",
function(){

if(!resultBlob)return;


let ext="jpg";

const mime=
document.getElementById(
"format"
).value;


if(mime==="image/png")
ext="png";

if(mime==="image/webp")
ext="webp";


const a=
document.createElement("a");

a.href=resultURL;

a.download=
"AsimTech_ID_Photo."+
ext;

document.body.appendChild(a);

a.click();

document.body.removeChild(a);


success(
"✅ Download Successful!<br>ID Photo saved."
);

});


/* CREATE 4×6 SHEET */

document.getElementById(
"sheetBtn"
).addEventListener(
"click",
function(){

if(!resultBlob)return;


const sheet=
document.getElementById(
"sheetCanvas"
);

sheet.width=1200;

sheet.height=1800;


const s=
sheet.getContext("2d");


s.fillStyle="white";

s.fillRect(
0,
0,
sheet.width,
sheet.height
);


const img=new Image();


img.onload=function(){

