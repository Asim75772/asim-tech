<script>

/* =====================================================
   GLOBAL
===================================================== */

const canvas =
document.getElementById("canvas");

const ctx =
canvas.getContext("2d");


/* =====================================================
   CANVAS SIZE
===================================================== */

function changeCanvasSize(){

    const value =
    document.getElementById("canvasSize").value;

    const parts =
    value.split("x");

    canvas.width =
    parseInt(parts[0]);

    canvas.height =
    parseInt(parts[1]);

    updateCanvas();
}


/* =====================================================
   BACKGROUND
===================================================== */

function drawBackground(){

    const style =
    document.getElementById(
        "backgroundStyle"
    ).value;

    const bg =
    document.getElementById(
        "bgColor"
    ).value;


    if(style === "solid"){

        ctx.fillStyle = bg;

        ctx.fillRect(
            0,
            0,
            canvas.width,
            canvas.height
        );

    }


    else if(style === "gradient"){

        const gradient =
        ctx.createLinearGradient(
            0,
            0,
            canvas.width,
            canvas.height
        );

        gradient.addColorStop(
            0,
            "#001a36"
        );

        gradient.addColorStop(
            1,
            "#008cff"
        );

        ctx.fillStyle =
        gradient;

        ctx.fillRect(
            0,
            0,
            canvas.width,
            canvas.height
        );

    }


    else if(style === "sunset"){

        const gradient =
        ctx.createLinearGradient(
            0,
            0,
            canvas.width,
            canvas.height
        );

        gradient.addColorStop(
            0,
            "#35104d"
        );

        gradient.addColorStop(
            .5,
            "#e94f64"
        );

        gradient.addColorStop(
            1,
            "#ff9d3d"
        );

        ctx.fillStyle =
        gradient;

        ctx.fillRect(
            0,
            0,
            canvas.width,
            canvas.height
        );

    }


    else if(style === "green"){

        const gradient =
        ctx.createLinearGradient(
            0,
            0,
            canvas.width,
            canvas.height
        );

        gradient.addColorStop(
            0,
            "#03291b"
        );

        gradient.addColorStop(
            1,
            "#00a86b"
        );

        ctx.fillStyle =
        gradient;

        ctx.fillRect(
            0,
            0,
            canvas.width,
            canvas.height
        );

    }


    else if(style === "purple"){

        const gradient =
        ctx.createLinearGradient(
            0,
            0,
            canvas.width,
            canvas.height
        );

        gradient.addColorStop(
            0,
            "#160c36"
        );

        gradient.addColorStop(
            1,
            "#7b3ff2"
        );

        ctx.fillStyle =
        gradient;

        ctx.fillRect(
            0,
            0,
            canvas.width,
            canvas.height
        );

    }

}


/* =====================================================
   TEXT DRAW
===================================================== */

function updateCanvas(){

    drawBackground();


    const text =
    document.getElementById(
        "text"
    ).value ||
    "আপনার লেখা এখানে";


    const font =
    document.getElementById(
        "font"
    ).value;


    const size =
    parseInt(
        document.getElementById(
            "size"
        ).value
    );


    const x =
    parseInt(
        document.getElementById(
            "posX"
        ).value
    );


    const y =
    parseInt(
        document.getElementById(
            "posY"
        ).value
    );


    const color =
    document.getElementById(
        "textColor"
    ).value;


    const strokeColor =
    document.getElementById(
        "strokeColor"
    ).value;


    const stroke =
    parseInt(
        document.getElementById(
            "stroke"
        ).value
    );


    const shadow =
    parseInt(
        document.getElementById(
            "shadow"
        ).value
    );


    document.getElementById(
        "sizeValue"
    ).innerText =
    size;


    document.getElementById(
        "xValue"
    ).innerText =
    x + "%";


    document.getElementById(
        "yValue"
    ).innerText =
    y + "%";


    document.getElementById(
        "strokeValue"
    ).innerText =
    stroke;


    /* FONT PREVIEW */

    const preview =
    document.getElementById(
        "fontPreview"
    );

    preview.style.fontFamily =
        "'" + font + "'";

    preview.innerText =
        text.substring(0,40);


    /* TEXT SETTINGS */

    ctx.save();

    ctx.font =
        "700 " +
        size +
        "px '" +
        font +
        "'";

    ctx.textAlign =
        "center";

    ctx.textBaseline =
        "middle";


    /* SHADOW */

    if(shadow > 0){

        ctx.shadowColor =
        "rgba(0,0,0,.75)";

        ctx.shadowBlur =
        shadow;

        ctx.shadowOffsetX =
        4;

        ctx.shadowOffsetY =
        6;

    }else{

        ctx.shadowColor =
        "transparent";

        ctx.shadowBlur =
        0;

        ctx.shadowOffsetX =
        0;

        ctx.shadowOffsetY =
        0;

    }


    const drawX =
    canvas.width *
    x /
    100;


    const drawY =
    canvas.height *
    y /
    100;


    /* MULTI-LINE TEXT */

    const lines =
    text.split("\n");

    const lineHeight =
    size * 1.25;


    const startY =
    drawY -
    ((lines.length - 1) *
    lineHeight / 2);


    lines.forEach(
        function(line,index){

            const lineY =
            startY +
            index *
            lineHeight;


            /* OUTLINE */

            if(stroke > 0){

                ctx.lineWidth =
                    stroke;

                ctx.strokeStyle =
                    strokeColor;

                ctx.strokeText(
                    line,
                    drawX,
                    lineY
                );

            }


            /* FILL */

            ctx.fillStyle =
                color;

            ctx.fillText(
                line,
                drawX,
                lineY
            );

        }
    );


    ctx.restore();

}


/* =====================================================
   COLOR
===================================================== */

function setColor(value){

    document.getElementById(
        "textColor"
    ).value =
    value;

    updateCanvas();

}


/* =====================================================
   DOWNLOAD PNG
===================================================== */

function downloadPNG(){

    updateCanvas();


    canvas.toBlob(
        function(blob){

            if(!blob){

                alert(
                    "Download failed."
                );

                return;
            }


            const url =
            URL.createObjectURL(blob);


            const a =
            document.createElement("a");


            a.href =
            url;


            a.download =
            "asim-tech-bangla-banner.png";


            document.body.appendChild(a);

            a.click();

            document.body.removeChild(a);


            setTimeout(
                function(){

                    URL.revokeObjectURL(url);

                },
                1000
            );

        },
        "image/png"
    );

}


/* =====================================================
   SHARE
===================================================== */

async function shareDesign(){

    updateCanvas();


    if(!navigator.share){

        alert(
            "এই browser-এ direct Share support নেই। Download PNG ব্যবহার করুন।"
        );

        return;
    }


    canvas.toBlob(
        async function(blob){

            const file =
            new File(
                [blob],
                "asim-tech-banner.png",
                {
                    type:"image/png"
                }
            );


            try{

                if(
                    navigator.canShare &&
                    navigator.canShare({
                        files:[file]
                    })
                ){

                    await navigator.share({

                        title:
                        "Asim Tech Banner",

                        text:
                        "Created with Asim Tech Bangla Banner Designer",

                        files:[file]

                    });

                }else{

                    await navigator.share({

                        title:
                        "Asim Tech Banner",

                        text:
                        "Created with Asim Tech Bangla Banner Designer"

                    });

                }

            }catch(error){

                console.log(error);

            }

        },
        "image/png"
    );

}


