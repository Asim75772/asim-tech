<script>

/* =====================================================
   VARIABLES
===================================================== */

let selectedFile = null;

let extractedRows = [];

let deferredInstallPrompt = null;


/* =====================================================
   ELEMENTS
===================================================== */

const imageInput =
document.getElementById(
    "imageInput"
);


const preview =
document.getElementById(
    "preview"
);


const previewImage =
document.getElementById(
    "previewImage"
);


const extractButton =
document.getElementById(
    "extractButton"
);


const clearButton =
document.getElementById(
    "clearButton"
);


const language =
document.getElementById(
    "language"
);


const progressBox =
document.getElementById(
    "progressBox"
);


const progressText =
document.getElementById(
    "progressText"
);


const progressBar =
document.getElementById(
    "progressBar"
);


const statusBox =
document.getElementById(
    "status"
);


const resultSection =
document.getElementById(
    "resultSection"
);


const tableWrapper =
document.getElementById(
    "tableWrapper"
);


const dataTable =
document.getElementById(
    "dataTable"
);


const resultControls =
document.getElementById(
    "resultControls"
);


const installButton =
document.getElementById(
    "installButton"
);


/* =====================================================
   STATUS
===================================================== */

function setStatus(
    message,
    type=""
){

    statusBox.className =
        "status show " + type;

    statusBox.innerHTML =
        message;
}


/* =====================================================
   IMAGE SELECT
===================================================== */

imageInput.addEventListener(
    "change",
    function(event){

        const file =
            event.target.files[0];


        if(!file){

            return;
        }


        if(!file.type.startsWith("image/")){

            setStatus(
                "❌ Please select an image file.",
                "error"
            );

            return;
        }


        selectedFile =
            file;


        const reader =
            new FileReader();


        reader.onload =
            function(e){

                previewImage.src =
                    e.target.result;

                preview.classList.add(
                    "show"
                );

            };


        reader.readAsDataURL(
            file
        );


        extractButton.disabled =
            false;


        setStatus(
            "✅ Image selected. Tap Extract Table.",
            "success"
        );

    }
);


/* =====================================================
   OCR
===================================================== */

extractButton.addEventListener(
    "click",
    extractTable
);


async function extractTable(){

    if(!selectedFile){

        setStatus(
            "❌ Please select an image first.",
            "error"
        );

        return;
    }


    if(
        typeof Tesseract ===
        "undefined"
    ){

        setStatus(
            "❌ OCR library could not be loaded. Please check your internet connection.",
            "error"
        );

        return;
    }


    extractButton.disabled =
        true;


    progressBox.classList.add(
        "show"
    );


    progressBar.style.width =
        "0%";


    progressText.textContent =
        "Starting OCR...";


    setStatus(
        "⏳ Reading text from image..."
    );


    try{

        const lang =
            language.value;


        const worker =
            await Tesseract.createWorker(
                lang,
                1,
                {

                    logger:function(info){

                        if(
                            typeof info.progress ===
                            "number"
                        ){

                            const percent =
                                Math.round(
                                    info.progress *
                                    100
                                );


                            progressBar.style.width =
                                percent + "%";


                            if(info.status){

                                progressText.textContent =
                                    info.status +
                                    " " +
                                    percent +
                                    "%";

                            }

                        }

                    }

                }
            );


        const result =
            await worker.recognize(
                selectedFile
            );


        await worker.terminate();


        progressBar.style.width =
            "100%";


        progressText.textContent =
            "OCR completed";


        const text =
            result.data.text || "";


        if(!text.trim()){

            throw new Error(
                "No readable text was found."
            );

        }


        extractedRows =
            convertTextToRows(
                text
            );


        if(
            !extractedRows.length
        ){

            throw new Error(
                "Could not create table data."
            );

        }


        renderTable(
            extractedRows
        );


        resultSection.style.display =
            "block";


        tableWrapper.classList.add(
            "show"
        );


        resultControls.classList.add(
            "show"
        );


        setStatus(

            "✅ Text extracted successfully. " +
            "You can edit the table before downloading.",

            "success"

        );


        resultSection.scrollIntoView({
            behavior:"smooth",
            block:"start"
        });


    }catch(error){

        console.error(error);


        setStatus(

            "❌ OCR failed.<br><br>" +
            escapeHtml(
                error.message ||
                "Please try a clearer image."
            ),

            "error"

        );

    }


    extractButton.disabled =
        false;

}


/* =====================================================
   CONVERT OCR TEXT TO ROWS
===================================================== */

function convertTextToRows(
    text
){

    const lines =
        text
        .split(/\r?\n/)
        .map(
            line =>
            line.trim()
        )
        .filter(
            line =>
            line.length > 0
        );


    if(!lines.length){

        return [];
    }


    const rows =
        [];


    lines.forEach(
        function(line){

            /*
               Try to identify columns
               using tabs first.
            */

            let parts =
                line.split(/\t+/);


            /*
               If there are no tabs,
               try multiple spaces.
            */

            if(parts.length === 1){

                parts =
                    line
                    .split(/\s{2,}/)
                    .map(
                        x => x.trim()
                    )
                    .filter(Boolean);

            }


            /*
               If still one part,
               keep complete line in
               one cell.
            */

            if(parts.length === 0){

                parts = [line];

            }


            rows.push(
                parts
            );

        }
    );


    /*
       Make all rows equal length.
    */

    const maxColumns =
        Math.max(
            ...rows.map(
                row => row.length
            )
        );


    return rows.map(
        function(row){

            while(
                row.length <
                maxColumns
            ){

                row.push("");

            }


            return row;

        }
    );

}


/* =====================================================
   RENDER TABLE
===================================================== */

function renderTable(
    rows
){

    dataTable.innerHTML =
        "";


    if(
        !rows ||
        !rows.length
    ){

        return;
    }


    const columnCount =
        Math.max(
            ...rows.map(
                row => row.length
            )
        );


    /*
       HEADER
    */

    const thead =
        document.createElement(
            "thead"
        );


    const headerRow =
        document.createElement(
            "tr"
        );


    for(
        let c = 0;
        c < columnCount;
        c++
    ){

        const th =
            document.createElement(
                "th"
            );


        th.contentEditable =
            "true";


        th.textContent =
            "Column " +
            (c + 1);


        headerRow.appendChild(
            th
        );

    }


    thead.appendChild(
        headerRow
    );


    dataTable.appendChild(
        thead
    );


    /*
       BODY
    */

    const tbody =
        document.createElement(
            "tbody"
        );


    rows.forEach(
        function(row){

            const tr =
                document.createElement(
                    "tr"
                );


            for(
                let c = 0;
                c < columnCount;
                c++
            ){

                const td =
                    document.createElement(
                        "td"
                    );


                td.contentEditable =
                    "true";


                td.textContent =
                    row[c] || "";


                tr.appendChild(
                    td
                );

            }


            tbody.appendChild(
                tr
            );

        }
    );


    dataTable.appendChild(
        tbody
    );

}


/* =====================================================
   READ TABLE
===================================================== */

function readTable(){

    const rows =
        [];


    const tableRows =
        dataTable.querySelectorAll(
            "tr"
        );


    tableRows.forEach(
        function(tr){

            const cells =
                tr.querySelectorAll(
                    "th,td"
                );


            const row =
                [];


            cells.forEach(
                function(cell){

                    row.push(
                        cell.innerText.trim()
                    );

                }
            );


            rows.push(
                row
            );

        }
    );


    return rows;

}


/* =====================================================
   DOWNLOAD EXCEL
===================================================== */

document
.getElementById(
    "downloadExcel"
)
.addEventListener(
    "click",
    function(){

        const rows =
            readTable();


        if(!rows.length){

            alert(
                "No table data available."
            );

            return;
        }


        if(
            typeof XLSX ===
            "undefined"
        ){

            alert(
                "Excel library could not be loaded."
            );

            return;
        }


        const worksheet =
            XLSX.utils.aoa_to_sheet(
                rows
            );


        const workbook =
            XLSX.utils.book_new();


        XLSX.utils.book_append_sheet(
            workbook,
            worksheet,
            "Sheet1"
        );


        /*
           Auto width.
        */

        const widths =
            [];


        rows.forEach(
            function(row){

                row.forEach(
                    function(value,index){

                        const length =
                            String(
                                value || ""
                            ).length;


                        widths[index] =
                            Math.max(
                                widths[index] || 10,
                                Math.min(
                                    length + 2,
                                    40
                                )
                            );

                    }
                );

            }
        );


        worksheet["!cols"] =
            widths.map(
                function(width){

                    return {
                        wch:width
                    };

                }
            );


        XLSX.writeFile(
            workbook,
            "asim-image-to-excel.xlsx"
        );


        setStatus(
            "✅ Excel file downloaded successfully.",
            "success"
        );

    }
);


/* =====================================================
   DOWNLOAD CSV
===================================================== */

document
.getElementById(
    "downloadCSV"
)
.addEventListener(
    "click",
    function(){

        const rows =
            readTable();


        if(!rows.length){

            alert(
                "No table data available."
            );

            return;
        }


        const csv =
            rows
            .map(
                function(row){

                    return row.map(
                        function(cell){

                            const value =
                                String(
                                    cell || ""
                                ).replace(
                                    /"/g,
                                    '""'
                                );


                            return '"' +
                                value +
                                '"';

                        }
                    ).join(",");

                }
            )
            .join("\n");


        const blob =
            new Blob(
                ["\ufeff" + csv],
                {
                    type:
                    "text/csv;charset=utf-8"
                }
            );


        downloadBlob(
            blob,
            "asim-image-to-excel.csv"
        );


        setStatus(
            "✅ CSV file downloaded.",
            "success"
        );

    }
);


