/* =====================================================
   COPY TABLE
===================================================== */

document
.getElementById(
    "copyTable"
)
.addEventListener(
    "click",
    async function(){

        const rows =
            readTable();


        const text =
            rows
            .map(
                row =>
                row.join("\t")
            )
            .join("\n");


        try{

            await navigator.clipboard.writeText(
                text
            );


            setStatus(
                "✅ Table copied to clipboard.",
                "success"
